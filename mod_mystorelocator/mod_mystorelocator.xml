<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_mystorelocator</name>
	<author>SH Software Solution (Internet am Dornbusch, Sajjad Hanifa)</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Internet am Dornbusch, Sajjad Hanifa</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>info@my-store-locator.com</authorEmail>
	<authorUrl>https://my-store-locator.com/?utm_source=joomla&amp;utm_medium=integration&amp;utm_campaign=joomla-plugin</authorUrl>
	<version>1.0.0</version>
	<description>MOD_MYSTORELOCATOR_XML_DESCRIPTION</description>
	<namespace path="src">Shss\Module\MyStoreLocator</namespace>

	<files>
		<folder module="mod_mystorelocator">services</folder>
		<folder>language</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<filename>LICENSE.txt</filename>
	</files>

	<media destination="mod_mystorelocator" folder="media">
		<filename>connect-return.html</filename>
		<folder>js</folder>
	</media>

	<!-- Update server: updates.xml is published on the website next to the zip (see joomla/updates.xml). -->
	<updateservers>
		<server type="extension" priority="1" name="My Store Locator">https://my-store-locator.com/downloads/joomla-updates.xml</server>
	</updateservers>

	<config>
		<fields name="params">
			<fieldset name="basic"
				addfieldprefix="Shss\Module\MyStoreLocator\Site\Field"
				addruleprefix="Shss\Module\MyStoreLocator\Site\Rule">
				<field
					name="intro"
					type="note"
					label="MOD_MYSTORELOCATOR_INTRO_LABEL"
					description="MOD_MYSTORELOCATOR_INTRO_DESC"
					class="alert alert-info"
				/>
				<field
					name="token"
					type="msltoken"
					label="MOD_MYSTORELOCATOR_FIELD_TOKEN_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_TOKEN_DESC"
					required="true"
					filter="Shss\Module\MyStoreLocator\Site\Helper\MyStoreLocatorHelper::filterToken"
					validate="msltoken"
					message="MOD_MYSTORELOCATOR_FIELD_TOKEN_INVALID"
				/>
				<field
					name="height"
					type="text"
					label="MOD_MYSTORELOCATOR_FIELD_HEIGHT_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_HEIGHT_DESC"
					default="auto"
					filter="Shss\Module\MyStoreLocator\Site\Helper\MyStoreLocatorHelper::filterHeight"
					hint="auto"
				/>
				<field
					name="language"
					type="list"
					label="MOD_MYSTORELOCATOR_FIELD_LANGUAGE_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_LANGUAGE_DESC"
					default="auto"
					validate="options"
				>
					<option value="auto">MOD_MYSTORELOCATOR_FIELD_LANGUAGE_AUTO</option>
					<option value="de">MOD_MYSTORELOCATOR_FIELD_LANGUAGE_DE</option>
					<option value="en">MOD_MYSTORELOCATOR_FIELD_LANGUAGE_EN</option>
				</field>
				<field
					name="consent"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="MOD_MYSTORELOCATOR_FIELD_CONSENT_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_CONSENT_DESC"
					default="1"
					filter="integer"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="lazy"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="MOD_MYSTORELOCATOR_FIELD_LAZY_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_LAZY_DESC"
					default="1"
					filter="integer"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="layout_mode"
					type="list"
					label="MOD_MYSTORELOCATOR_FIELD_LAYOUT_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_LAYOUT_DESC"
					default="default"
					validate="options"
					showon="height:auto"
				>
					<option value="default">MOD_MYSTORELOCATOR_FIELD_LAYOUT_DEFAULT</option>
					<option value="split">MOD_MYSTORELOCATOR_FIELD_LAYOUT_SPLIT</option>
				</field>
				<field
					name="offset"
					type="number"
					label="MOD_MYSTORELOCATOR_FIELD_OFFSET_LABEL"
					description="MOD_MYSTORELOCATOR_FIELD_OFFSET_DESC"
					default="0"
					min="0"
					max="1000"
					step="1"
					filter="integer"
					showon="height:auto"
				/>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>
				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3"
					validate="CssIdentifier"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
